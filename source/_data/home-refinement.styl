// Homepage identity: pure gold as the sole accent, with neutral surfaces.
body:has(.world-home)
  background-color: #080808

.world-home-page.main-inner
  opacity: 1

.world-home-page .post-block
  padding: 0 !important
  overflow: visible
  background: transparent
  box-shadow: none

.world-home-page .post-body
  padding: 0

.world-home
  padding: 0
  color: var(--world-ink)

  &, [data-tone]
    --directory-accent: var(--world-gold)
    --directory-ink: var(--world-ink)
    --directory-muted: var(--world-muted)
    --directory-edge: var(--world-edge)
    --directory-soft: var(--world-gold-wash)

  ::selection
    color: #111
    background: var(--world-gold)

  strong::after
    display: none

  a:focus-visible
    outline: 2px solid var(--world-gold)
    outline-offset: 5px

  .home-hero
    margin: 0
    padding: 44px 44px 64px
    border: 1px solid rgba(255,215,0,.4)
    border-radius: 20px
    background: linear-gradient(110deg, rgba(5,5,5,.97), rgba(5,5,5,.83) 58%, rgba(5,5,5,.6)), url('/images/background.jpg') center 48% / cover
    box-shadow: 0 14px 50px rgba(0,0,0,.22), inset 0 0 50px rgba(255,215,0,.035)

    &::before
      right: -150px
      bottom: -245px
      width: 560px
      height: 560px
      border-color: rgba(255,215,0,.1)

    &::after
      display: none

    > .reading-eyebrow
      color: var(--world-gold)
      font-size: 11px
      letter-spacing: .24em

    h1
      margin: 20px 0

    .home-title-name
      color: #f5f5f5
      font-size: 22px
      font-weight: 400

    .home-title-world
      color: var(--world-gold)
      font: 86px/1.08 Georgia, 'Times New Roman', serif
      letter-spacing: .055em

    p
      color: #d6d6d6
      font-size: 15px
      line-height: 1.9

    .home-hero-clause
      display: inline-block

  .home-hero > .reading-eyebrow, .home-title-name, .home-title-world,
  .home-hero p, .home-hero-actions, .home-motif
    animation: home-text-arrive .75s var(--interaction-ease) both

  .home-title-name
    animation-delay: .08s

  .home-title-world
    animation-delay: .16s

  .home-hero p
    animation-delay: .25s

  .home-hero-actions
    animation-delay: .34s

  .home-motif
    animation-delay: .42s

  .home-celestial
    position: absolute
    top: 76px
    right: 40px
    width: 240px
    height: 240px
    color: var(--world-gold)
    pointer-events: none
    animation: home-orbit-drift 8s ease-in-out infinite alternate

  .home-hero-actions
    gap: 14px 26px
    margin-top: 28px

    a
      transition: background-color .18s, color .18s, box-shadow .18s, transform .18s

      span
        display: inline-block
        transition: transform .18s

    a:first-child
      padding: 11px 20px
      border-radius: 4px
      background: var(--world-gold)
      color: #111
      font-weight: 500

      &:hover, &:focus-visible
        background: var(--world-gold)
        box-shadow: 0 5px 22px rgba(255,215,0,.22), inset 0 0 0 1px rgba(255,255,255,.45)
        transform: translateY(-2px)

        span
          transform: translateX(3px)

      &:active
        box-shadow: 0 2px 8px rgba(255,215,0,.14)
        transform: translateY(0)

    a:last-child
      color: #f0f0f0
      padding: 8px 10px
      border-radius: 4px

      span
        margin-left: 8px
        color: var(--world-gold)

      &:hover, &:focus-visible
        background: rgba(255,215,0,.12)
        color: var(--world-gold)

        span
          transform: translate(2px, -2px)

  .home-motif
    right: 36px
    bottom: 24px
    color: var(--world-gold)
    font-size: 12px
    letter-spacing: .15em

    span + span::before
      background: var(--world-gold)

  .home-announcement
    display: block
    margin: 28px 0 0
    padding: 28px 32px
    border: 1px solid rgba(255,215,0,.5)
    border-radius: 14px
    background: linear-gradient(110deg, rgba(255,215,0,.09), transparent 65%), var(--world-paper)
    backdrop-filter: blur(12px)
    box-shadow: 0 8px 32px rgba(0,0,0,.1)

    h2
      color: var(--world-ink)
      font-size: 23px
      font-weight: 600
      margin: 0
      padding-top: 2px

      i
        margin-right: 4px
        color: #111

    p
      color: var(--world-muted)
      font-size: 15px
      line-height: 1.9

      > strong:first-child
        display: inline-block
        margin-bottom: 6px
        padding: 1px 7px
        border-radius: 3px
        background: var(--world-gold)
        color: #111
        font: 12px/1.9 Consolas, monospace

    a
      color: var(--world-ink)
      margin-top: 10px
      border-bottom: 2px solid var(--world-gold)
      padding: 1px 4px
      margin-left: -4px
      border-radius: 3px
      transition: background-color .18s, box-shadow .18s

      &:hover, &:focus-visible
        background: var(--world-gold)
        box-shadow: 0 0 0 3px rgba(255,215,0,.12)

  .reading-section-title
    display: flex
    flex-wrap: wrap
    justify-content: space-between
    align-items: center
    gap: 8px 20px
    margin-bottom: 20px
    padding: 0 0 16px
    border-bottom: 1px solid rgba(0,0,0,.1)

    h2
      color: var(--world-ink)
      font-size: 23px
      margin: 0
      position: relative
      padding-left: 16px

      &::before
        display: block
        content: ''
        position: absolute
        left: 0
        top: .25em
        bottom: .25em
        width: 4px
        border-radius: 2px
        background: var(--world-gold)

    .reading-eyebrow
      color: var(--world-muted)
      font-size: 10px
      letter-spacing: .12em

  .home-introduction, .home-navigation
    margin-top: 28px
    padding: 30px 32px
    border: 1px solid var(--world-paper)
    border-radius: 14px
    background: var(--world-paper)
    backdrop-filter: blur(12px)
    box-shadow: 0 8px 32px rgba(0,0,0,.1)

  .home-intro-paragraph
    align-items: start
    gap: 18px
    padding: 24px 0
    border-top: 1px solid var(--world-edge)

    &:first-child
      border-top: 0

    strong
      color: var(--world-ink)
      box-shadow: inset 0 -.28em rgba(255,215,0,.35)

  .home-paragraph-number
    display: grid
    place-items: center
    width: 30px
    height: 30px
    margin-top: 2px
    border: 1px solid rgba(255,215,0,.65)
    border-radius: 50%
    color: var(--world-muted)
    font: 11px/1 Consolas, monospace

  .home-paragraph-copy
    min-width: 0
    flex: 1

    h3
      margin: 0 0 8px
      padding: 0
      color: var(--world-ink)
      font-size: 16px
      letter-spacing: .025em

    p
      margin: 0
      color: var(--world-muted)
      font-size: 15px
      line-height: 2

  .home-navigation
    border-top: 2px solid var(--world-gold)

  .home-route-grid
    gap: 0 28px

  .home-route
    padding: 22px 10px
    border-bottom-color: var(--world-edge) !important
    transition: background-color .18s, border-color .18s

    > i
      background: rgba(255,215,0,.15)
      color: #111
      border-radius: 8px

    b
      color: var(--world-ink)
      font-size: 17px

    span span
      color: var(--world-muted)
      font-size: 12px

    > span:last-child
      display: grid
      place-items: center
      width: 26px
      height: 26px
      border-radius: 50%
      background: var(--world-gold)
      color: #111
      font-size: 14px
      transition: transform .18s, box-shadow .18s

    &:hover, &:focus-visible
      border-bottom-color: var(--world-gold) !important
      background-color: rgba(255,215,0,.065)

      > span:last-child
        transform: translateX(3px)
        box-shadow: 0 0 0 4px rgba(255,215,0,.15)

      b
        color: var(--world-ink)
        text-decoration: underline
        text-decoration-color: var(--world-gold)
        text-underline-offset: 5px

  .home-endnote
    margin-top: 24px
    padding-top: 16px
    color: var(--world-muted)
    font-size: 10px

    > span:last-child
      color: var(--world-muted)
      font: italic 15px/1.6 Georgia, serif
      letter-spacing: .025em

@media (min-width: 1100px)
  .world-home .home-hero
    h1
      max-width: calc(100% - 264px)

    p
      max-width: calc(100% - 264px)

@media (max-width: 1099px)
  .world-home .home-celestial
    display: none

@media (max-width: 767px)
  .world-home
    padding: 0 12px 24px

    .home-hero
      margin: 0
      padding: 30px 24px 62px
      border-radius: 14px

      .home-title-name
        font-size: 19px

      .home-title-world
        font-size: clamp(48px, 15vw, 62px)

      p
        font-size: 14px

    .home-hero-actions
      gap: 14px 20px
      font-size: 13px

      a:first-child
        gap: 18px
        padding: 10px 15px

    .home-motif
      right: 24px
      font-size: 11px

    .home-announcement
      margin-top: 20px
      padding: 22px 20px

    .home-introduction, .home-navigation
      margin-top: 20px
      padding: 24px 20px

    .reading-section-title
      gap: 8px 12px

      h2
        font-size: 21px

    .home-intro-paragraph
      gap: 12px
      padding: 22px 0

    .home-paragraph-number
      width: 26px
      height: 26px

    .home-paragraph-copy p
      font-size: 14px

    .reading-section-title .reading-eyebrow
      font-size: 9px

    .home-route
      gap: 12px
      padding: 18px 8px

@media (prefers-reduced-motion: reduce)
  .world-home *, .world-home *::before, .world-home *::after
    transition: none !important
    animation: none !important

@keyframes home-text-arrive
  from
    opacity: 0
    transform: translateY(12px)
    filter: blur(3px)
  to
    opacity: 1
    transform: translateY(0)
    filter: blur(0)

@keyframes home-orbit-drift
  from
    transform: translateY(0) rotate(-2deg)
  to
    transform: translateY(-5px) rotate(2deg)

// First visits include a welcome dialog: reveal the headline after it closes.
body:has(.swal-overlay--show-modal) .home-hero
  > .reading-eyebrow, .home-title-name, .home-title-world, p, .home-hero-actions, .home-motif
    animation-play-state: paused

body:has(.world-home)
  .swal-icon--success
    border-color: var(--world-gold)

  .swal-icon--success__line
    background: var(--world-gold)

  .swal-icon--success__ring
    border-color: var(--world-gold)
