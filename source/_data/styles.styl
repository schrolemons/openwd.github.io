@import 'world-tokens'
@import 'world-components'
@import 'world-prose'
@import 'content-directory'
@import 'reading-layout'
@import 'reading-profiles'
@import 'content-modules'
@import 'content-containers'
@import 'interactions'
@import 'home-refinement'
@import 'home-letter'
@import 'prose-ui'
@import 'welcome-dialog'

body
  background: url('/images/background.jpg') center / cover fixed no-repeat #080808

.main-inner, .content-wrap, .sidebar, .popup
  opacity: 1

.header-inner, .sidebar-inner
  color: var(--world-ink)
  background: var(--world-paper)
  border: 1px solid var(--world-edge)
  border-radius: 8px
  box-shadow: var(--world-shadow)

.header-inner
  border-top: 1px solid var(--world-gold)
.site-brand-container
  background: #171717
  color: #f5f5f5
.site-description, .site-author-name, .sidebar-nav li, .links-of-author a, .links-of-recent-posts a
  color: var(--world-ink)
.site-state-item-name, .site-description
  color: var(--world-muted)
.sidebar-nav li:hover,
.sidebar-toc-active .sidebar-nav-toc,
.sidebar-overview-active .sidebar-nav-overview,
.post-toc .nav .active > a,
.post-toc .nav .active-current > a
  color: var(--world-ink)
  border-bottom-color: var(--world-gold)
  &:hover, &:focus-visible
    color: var(--world-ink)
    border-bottom-color: var(--world-gold)
.post-toc .nav .active > a, .post-toc .nav .active-current > a
  background-color: var(--world-selected)
.post-copyright, .post-nav, .pagination
  color: var(--world-muted)
  border-color: var(--world-edge)
  background: var(--world-paper)
.post-copyright
  border-left-color: var(--world-gold)
.comments
  color: var(--world-ink)
  background: var(--world-paper)
  border: 1px solid var(--world-edge)
  border-radius: 8px
.back-to-top
  font-size: 18px
  height: 40px
.links-of-recent-posts
  font-size: 1em
  margin-top: 10px
.links-of-recent-posts-title
  font-size: 1.03em
  font-weight: 600
  margin-top: 0
.links-of-recent-posts-list
  list-style: none
  margin: 0
  padding: 0
