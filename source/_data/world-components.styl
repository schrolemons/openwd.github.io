// UI roles are shared by Markdown, directories, guides and owned standalone pages.
.world-theme-toggle, .world-prose-section, .world-standalone *, .world-standalone *::before, .world-standalone *::after
  box-sizing: border-box

::selection
  background: var(--world-gold)
  color: #171717

a, button, summary, [role='button']
  -webkit-tap-highlight-color: var(--world-gold-wash)

:is(a, button, summary, [role='button'], [tabindex='0']):focus-visible
  outline: 2px solid var(--world-gold)
  outline-offset: 4px

.btn, .post-button .btn, .swal-button, .world-primary-action
  color: unquote('color-mix(in srgb, var(--action-accent, var(--tone-blue)) 80%, var(--world-ink))') !important
  background: unquote('color-mix(in srgb, var(--action-accent, var(--tone-blue)) 7%, var(--world-paper))')
  border: 1px solid unquote('color-mix(in srgb, var(--action-accent, var(--tone-blue)) 40%, var(--world-edge))')
  border-radius: 6px
  padding: 10px 18px
  font: 500 14px/1.5 var(--world-ui-font)
  box-shadow: none
  cursor: pointer

  &:hover, &:focus-visible
    color: unquote('color-mix(in srgb, var(--action-accent, var(--tone-blue)) 80%, var(--world-ink))') !important
    background: unquote('color-mix(in srgb, var(--action-accent, var(--tone-blue)) 14%, var(--world-paper))')
    border-color: var(--action-accent, var(--tone-blue))
    box-shadow: none
    outline-color: var(--action-accent, var(--tone-blue)) !important

  &:active
    transform: none

.btn, .world-primary-action
  --action-accent: var(--note-accent, var(--content-accent, var(--tone-blue)))

.world-theme-toggle
  position: fixed
  bottom: calc(64px + env(safe-area-inset-bottom, 0px))
  right: 24px
  z-index: 9999
  width: 40px
  height: 40px
  display: grid
  place-items: center
  color: var(--world-ink)
  background: var(--world-paper)
  border: 1px solid var(--world-edge)
  border-radius: 8px
  box-shadow: 0 2px 8px rgba(0,0,0,.08)
  cursor: pointer

  &:hover
    border-color: var(--world-gold)

.world-theme-mark
  display: block
  width: 16px
  height: 16px
  border: 1px solid currentColor
  border-radius: 50%
  background: linear-gradient(90deg, currentColor 50%, transparent 50%)
  transition: transform .2s

.world-theme-toggle.is-dark .world-theme-mark
  transform: rotate(180deg)

.world-meta
  display: flex
  flex-wrap: wrap
  align-items: baseline
  justify-content: flex-start
  gap: 6px 18px
  color: var(--world-muted)
  font: 12px/1.8 var(--world-ui-font)
  margin: 12px 0 0

  &:empty
    display: none

  .post-meta-item
    margin: 0

    &::before, &::after
      display: none

  a
    color: inherit
    border-bottom: 1px solid var(--world-edge)

.world-reading-stats
  justify-content: flex-start
  color: var(--world-muted)
  font: 12px/1.8 var(--world-ui-font)

.reading-document .post-header .reading-kicker
  justify-content: flex-start

.world-endnote
  display: flex
  justify-content: center
  gap: 16px
  padding: 20px 0 0
  margin-top: 24px
  border-top: 1px solid var(--world-edge)
  color: var(--world-muted)
  font: 11px/1.8 var(--world-ui-font)
  letter-spacing: .08em

.swal-modal, .directory-qr-dialog, .popup, .search-popup
  color: var(--world-ink)
  background: var(--world-paper)
  border: 1px solid var(--world-edge)
  border-radius: 10px
  box-shadow: var(--world-shadow)

.swal-title, .swal-text, .directory-qr-title, .search-header, .search-input
  color: var(--world-ink)

.swal-icon--success::before, .swal-icon--success::after, .swal-icon--success__hide-corners
  background: var(--world-paper)

.rawhtml-wrapper
  border: 1px solid var(--world-edge) !important
  border-radius: var(--world-radius) !important

.rawhtml-bar
  background: var(--world-soft) !important
  border-color: var(--world-edge) !important
  color: var(--world-ink)

.rawhtml-bar-title
  color: var(--world-ink) !important

.rawhtml-bar button
  color: var(--world-ink) !important
  background: var(--world-surface) !important
  border-color: var(--world-edge) !important
  border-radius: 6px !important

@media (max-width: 767px)
  .world-theme-toggle
    right: 16px

// Fixed reading controls share the theme button's paper and dimensions.
// Keep progress inside the button so three digits never change its width.
.sidebar-toggle, .back-to-top
  appearance: none
  border: 0
  padding: 0
  font-family: var(--world-ui-font)

.sidebar-toggle, .back-to-top
  box-sizing: border-box
  width: 40px
  height: 40px
  margin: 0
  left: 24px
  right: auto
  color: var(--world-ink)
  background: var(--world-paper)
  border: 1px solid var(--world-edge)
  border-radius: 8px
  box-shadow: 0 2px 8px rgba(0,0,0,.08)
  opacity: 1

  &:hover, &:focus-visible
    color: var(--world-ink)
    background: var(--world-hover)
    border-color: var(--world-gold)

.sidebar-toggle
  bottom: calc(114px + env(safe-area-inset-bottom, 0px))
  padding: 11px

  .toggle-line
    background: currentColor
    border-radius: 1px

  &:hover .toggle-line
    background: currentColor

.back-to-top
  bottom: calc(64px + env(safe-area-inset-bottom, 0px))
  flex-direction: column
  justify-content: center
  gap: 2px
  visibility: hidden
  opacity: 0
  pointer-events: none
  transition: opacity .18s

  &.back-to-top-on
    bottom: calc(64px + env(safe-area-inset-bottom, 0px))
    visibility: visible
    opacity: 1
    pointer-events: auto

  .fa
    display: none

  &::before
    content: ''
    width: 7px
    height: 7px
    border-top: 1.5px solid currentColor
    border-left: 1.5px solid currentColor
    transform: translateY(2px) rotate(45deg)

  span
    margin: 0
    font: 500 10px/14px var(--world-ui-font)
    font-variant-numeric: tabular-nums

@media (max-width: 991px)
  .sidebar-toggle, .back-to-top
    left: 16px

@media (prefers-reduced-motion: reduce)
  *, *::before, *::after
    scroll-behavior: auto !important
