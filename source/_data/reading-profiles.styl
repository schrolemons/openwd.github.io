// Profiles own reading rhythm and content layout, not component colours.
.main:has(.reading-document):not(:has(.post-preview))
  --world-column-measure: 816px
  .main-inner
    max-width: var(--world-column-measure)
    margin-left: auto
    margin-right: auto

.main:has(.reading-document[data-reading-style='story']):not(:has(.post-preview))
  --world-column-measure: 684px
.main:has(.reading-document[data-reading-style='essay']):not(:has(.post-preview))
  --world-column-measure: 720px
.main:has(.reading-document[data-reading-style='poetry']):not(:has(.post-preview))
  --world-column-measure: 648px
.main:has(.reading-document[data-reading-style='lore']):not(:has(.post-preview))
  --world-column-measure: 832px
.main:has(.reading-document[data-reading-style='info']):not(:has(.post-preview))
  --world-column-measure: 768px
.main:has(.reading-document[data-reading-style='profile']):not(:has(.post-preview))
  --world-column-measure: 1024px
.main:has(.reading-document[data-reading-style='guide']):not(:has(.post-preview))
  --world-column-measure: 1024px

@media (min-width: 992px)
  .main:has(.reading-document):not(:has(.post-preview))
    width: calc(100% - 40px)
    max-width: calc(var(--world-column-measure) + 252px)
    .main-inner
      margin-left: 0
      margin-right: 0

.main-inner:has(.reading-document)
  opacity: 1
.post-block:has(.reading-document), .post-block.reading-document
  background: transparent
  padding: 0 !important
  box-shadow: none
.reading-document
  --reading-measure: var(--world-column-measure, 816px)
  --reading-size: 17px
  --reading-leading: 1.95
  --reading-font: var(--world-ui-font)
  color: var(--world-ink)
  .post-header
    box-sizing: border-box
    width: 100%
    max-width: var(--reading-measure)
    margin-left: auto
    margin-right: auto
    text-align: left
    margin-bottom: var(--world-block-gap)
    padding: 28px 32px
    background: var(--world-paper)
    border: 1px solid var(--world-edge)
    border-top: 2px solid var(--world-gold)
    border-radius: 8px
    box-shadow: var(--world-shadow)
  .post-title
    color: var(--world-ink)
    font: 600 clamp(24px, 2.4vw, 32px)/1.5 var(--world-ui-font)
    letter-spacing: .025em
  .post-description
    text-align: left
    color: var(--world-muted)
    font: 14px/1.9 var(--world-ui-font)
  .post-footer
    box-sizing: border-box
    width: 100%
    max-width: var(--reading-measure)
    margin-left: auto
    margin-right: auto
    margin-top: var(--world-block-gap)
    padding: 24px 28px
    border: 1px solid var(--world-edge)
    border-radius: 8px
    background: var(--world-paper)
    color: var(--world-muted)
    font: 13px/1.8 var(--world-ui-font)
    overflow-wrap: anywhere
  .reading-prose
    width: 100%
    max-width: var(--reading-measure)
    margin: 0 auto
    font-family: var(--reading-font)
    font-size: var(--reading-size)
    line-height: var(--reading-leading)
    letter-spacing: .015em
    text-align: left
    overflow-wrap: anywhere
    p
      line-height: inherit
.reading-kicker
  display: flex
  flex-wrap: wrap
  align-items: baseline
  gap: 8px 12px
  margin: 0 0 12px
  font: 12px/1.6 var(--world-ui-font)
  color: var(--world-muted)
  span:first-child
    color: var(--directory-accent)
    padding: 3px 10px
    border: 1px solid var(--world-edge)
    border-radius: 5px
    background: var(--world-soft)
    font-weight: 600
// Generated legacy article indexes share one compact summary role.
.post-preview .reading-document
  .post-header
    max-width: none
    margin-bottom: 0
    border-bottom: 0
    border-radius: 8px 8px 0 0
  .post-body
    padding: 24px 32px
    background: var(--world-paper)
    border: 1px solid var(--world-edge)
    border-top: 0
    border-radius: 0 0 8px 8px
  .reading-preview
    max-width: none
    font: 16px/1.9 var(--world-ui-font)
  .post-footer
    margin: 0
    padding: 0
    border: 0
    background: none
  .post-eof
    margin: var(--world-block-gap) auto
    background: var(--world-gold)
.reading-document[data-reading-style='story']
  --reading-size: 18px
  --reading-leading: 2.05
  --reading-font: 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', SimSun, serif
.reading-document[data-reading-style='essay']
  --reading-size: 18px
  --reading-leading: 2
.reading-document[data-reading-style='poetry']
  --reading-size: 18px
  --reading-leading: 2.2
  --reading-font: 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', SimSun, serif
  .world-prose-section > p
    margin-bottom: 2em
.reading-document[data-reading-style='lore']
  --reading-size: 16px
  --reading-leading: 1.95
  .reading-prose h4
    padding: 8px 12px
    border-radius: 6px
    background: var(--world-soft)
    border-left: 2px solid var(--world-gold)
  .reading-prose .note h4
    background: none
    padding: 0
    border: 0
.reading-document[data-reading-style='info'], .reading-document[data-reading-style='profile']
  --reading-size: 16px
  --reading-leading: 1.9
.reading-document[data-reading-style='profile'] .reading-prose
  .photos-page
    margin: 24px 0
  .img-list
    display: block
  .img-column
    display: grid
    grid-template-columns: repeat(3, minmax(0, 1fr))
    align-items: start
    gap: 12px
    width: 100%
    img
      width: 100%
      margin: 0
      object-fit: contain
@media (max-width: 767px)
  .post-preview .reading-document .post-body
    padding: 18px 20px
  .reading-document
    --reading-size: 16px
    .post-header
      padding: 22px 20px
    .post-title
      font-size: 24px
    .post-footer
      padding: 20px 18px
  .reading-document[data-reading-style='story'], .reading-document[data-reading-style='poetry'], .reading-document[data-reading-style='essay']
    --reading-size: 17px
  .reading-document[data-reading-style='profile'] .reading-prose .img-column
    grid-template-columns: minmax(0, 1fr)

@media (max-width: 991px)
  .main:has(.reading-document):not(:has(.post-preview)) .main-inner
    padding: 0 18px !important
