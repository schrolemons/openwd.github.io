// Homepage correspondence: a dark envelope followed by three separate sheets.
.world-home
  .home-hero
    padding: 50px 48px 76px
    border-radius: 3px
    border-color: rgba(255,215,0,.6)
    background: linear-gradient(110deg, rgba(5,5,5,.97), rgba(5,5,5,.92) 60%, rgba(5,5,5,.78)), url('/images/background.jpg') center / cover
    box-shadow: 0 18px 50px rgba(0,0,0,.32), inset 0 0 0 6px rgba(255,215,0,.035)

    &::before
      left: 14px
      right: 14px
      top: 14px
      bottom: 14px
      width: auto
      height: auto
      border: 1px solid rgba(255,215,0,.18)
      border-radius: 0

    &::after
      display: block
      left: 48px
      right: 48px
      bottom: 56px
      top: auto
      width: auto
      height: 1px
      border: 0
      border-radius: 0
      background: linear-gradient(90deg, rgba(255,215,0,.35), rgba(255,215,0,.04))

    h1
      margin: 28px 0 24px

    h1, p
      max-width: calc(100% - 232px)

    .home-title-name
      font-size: 19px
      letter-spacing: .15em

    .home-title-world
      font-size: 78px

  .home-envelope-stamp
    position: absolute
    top: 42px
    right: 42px
    width: 128px
    height: 152px
    padding: 12px
    border: 2px dashed rgba(255,215,0,.65)
    outline: 1px solid rgba(255,215,0,.18)
    outline-offset: -8px
    color: var(--world-gold)
    text-align: center
    pointer-events: none

    .home-celestial
      display: block
      position: static
      width: 100%
      height: 98px
      animation: none

    > span
      display: block
      font: 10px/1.8 Georgia, serif
      letter-spacing: .2em

  .home-envelope-postmark
    position: absolute
    top: 159px
    right: 135px
    display: flex
    flex-direction: column
    align-items: center
    justify-content: center
    width: 112px
    height: 112px
    border: 1px solid rgba(255,215,0,.4)
    border-radius: 50%
    box-shadow: inset 0 0 0 5px rgba(255,215,0,.035)
    color: rgba(255,215,0,.6)
    font-size: 11px
    line-height: 2
    transform: rotate(-12deg)
    pointer-events: none

    time
      font: 10px/2 Consolas, monospace

    &::after
      content: ''
      position: absolute
      left: 96px
      top: 50px
      width: 80px
      height: 12px
      border-top: 1px solid rgba(255,215,0,.3)
      border-bottom: 1px solid rgba(255,215,0,.3)

  .home-motif
    right: 48px
    bottom: 28px

  .home-envelope-open
    position: absolute
    left: 48px
    bottom: 28px
    z-index: 12
    display: inline-flex
    align-items: center
    gap: 12px
    color: var(--world-gold)
    font-size: 11px
    letter-spacing: .08em
    padding: 0 3px
    border-radius: 2px
    animation: home-scroll-hint 2.4s ease-in-out infinite alternate

    &:hover, &:focus-visible
      background: rgba(255,215,0,.14)

  .home-envelope-peeks
    display: none
    position: absolute
    left: 20px
    right: 20px
    top: 100%
    height: 56px
    z-index: -1
    pointer-events: none

    > span
      display: block
      position: absolute
      top: 0
      left: 0
      right: 0
      height: 24px
      padding: 0 18px
      background: var(--world-soft)
      border: 1px solid var(--world-edge)
      box-shadow: 0 3px 8px rgba(0,0,0,.16)
      color: var(--world-muted)
      font: 10px/24px 'Microsoft YaHei', sans-serif
      text-align: right
      letter-spacing: .1em
      z-index: 3

      &:nth-child(2)
        top: 16px
        left: 8px
        right: 8px
        z-index: 2

      &:nth-child(3)
        top: 32px
        left: 16px
        right: 16px
        z-index: 1

  .home-announcement, .home-introduction, .home-navigation
    position: relative
    margin: 40px 14px 0
    padding: 34px 38px
    border: 1px solid var(--world-paper)
    border-radius: 2px
    background: linear-gradient(90deg, rgba(0,0,0,.018), transparent 7%), var(--world-paper)
    backdrop-filter: none
    box-shadow: 0 18px 40px rgba(0,0,0,.2)

    &::before
      content: ''
      position: absolute
      left: 5px
      right: 5px
      bottom: -7px
      height: 6px
      border: 1px solid rgba(0,0,0,.08)
      border-top: 0
      background: var(--world-paper)
      box-shadow: 0 4px 9px rgba(0,0,0,.08)
      pointer-events: none

    &::after
      content: ''
      position: absolute
      top: -1px
      right: -1px
      width: 25px
      height: 25px
      background: linear-gradient(225deg, var(--world-edge) 49%, var(--world-soft) 50%, var(--world-paper) 85%)
      clip-path: polygon(0 0, 100% 100%, 0 100%)
      pointer-events: none

  .reading-section-title
    align-items: center
    padding-bottom: 20px
    margin-bottom: 24px
    border-bottom: 1px solid rgba(255,215,0,.7)

    h2
      padding: 0
      font-family: 'Noto Serif SC', 'Songti SC', SimSun, serif
      font-weight: 600
      letter-spacing: .12em

      &::before
        display: none

  .home-letter-folio
    display: flex
    align-items: center
    gap: 18px

  .home-letter-number
    color: var(--world-ink)
    font: 24px/1.2 Georgia, serif
    white-space: nowrap

    small
      color: var(--world-muted)
      font: 10px/1.2 Consolas, monospace

  .home-announcement p
    margin-bottom: 0

  .home-endnote
    padding-top: 22px
    border-top: 1px solid var(--world-edge)

@media (max-width: 1099px)
  .world-home
    .home-hero h1, .home-hero p
      max-width: 100%

    .home-envelope-stamp
      top: 30px
      right: 30px
      width: 96px
      height: 112px
      padding: 9px

      .home-celestial
        height: 69px

      > span
        font-size: 8px

    .home-envelope-postmark
      display: none

@media (min-width: 768px) and (max-width: 1099px)
  .world-home .home-hero h1
    max-width: calc(100% - 116px)

@media (max-width: 767px)
  .world-home
    .home-hero
      padding: 32px 24px 68px

      > .reading-eyebrow
        min-height: 58px
        padding-top: 7px
        font-size: 10px

      h1
        margin: 10px 0 20px

      .home-title-name
        font-size: 18px

      .home-title-world
        font-size: clamp(46px, 14vw, 58px)

      &::after
        left: 24px
        right: 24px
        bottom: 48px

    .home-envelope-stamp
      top: 26px
      right: 24px
      width: 68px
      height: 82px
      padding: 6px
      outline-offset: -5px
      border-width: 1px

      .home-celestial
        height: 50px

      > span
        font-size: 7px

    .home-motif
      right: 24px
      bottom: 22px

    .home-envelope-open
      left: 24px
      bottom: 22px
      font-size: 10px
      gap: 6px

    .home-announcement, .home-introduction, .home-navigation
      margin: 30px 2px 0
      padding: 26px 20px

    .home-letter-folio
      gap: 10px

      .reading-eyebrow
        display: none

    .home-letter-number
      font-size: 23px

    .reading-section-title
      padding-bottom: 16px
      margin-bottom: 20px

// A native scroll runway keeps the cover still while all three sheets fan out.
.home-mail-scene
  position: relative
  display: flow-root
  overflow-anchor: none

.world-home.is-scroll-letter
  position: sticky
  top: var(--envelope-top)
  --letter-progress: 0

  .home-hero
    position: relative
    z-index: 10
    overflow: visible

  .home-envelope-peeks
    display: block
    opacity: unquote('clamp(0, calc(1 - var(--letter-progress) * 5), 1)')

  > .home-announcement, > .home-introduction, > .home-navigation
    transform: unquote('translateY(calc(var(--letter-shift) * (1 - var(--letter-progress))))')
    clip-path: unquote('inset(0 0 calc((1 - var(--letter-progress)) * 100%) 0)')
    transition: none
    will-change: transform, clip-path

  &.is-letter-expanded
    .home-envelope-open
      animation: none
      visibility: hidden

    > .home-announcement, > .home-introduction, > .home-navigation
      clip-path: none
      will-change: auto

@media print
  .home-mail-scene
    height: auto !important

  .world-home.is-scroll-letter
    position: static
    padding-top: 0

    > .home-announcement, > .home-introduction, > .home-navigation
      transform: none
      clip-path: none

  .home-envelope-open
    display: none

  .home-envelope-peeks
    display: none !important

@keyframes home-scroll-hint
  from
    opacity: .4
  to
    opacity: 1

// Homepage sidebar: a contents sheet and an attached personal note.
body:has(.world-home)
  .header, .sidebar-inner
    border-radius: 3px
    border-top: 1px solid rgba(255,215,0,.5)
    box-shadow: 0 8px 24px rgba(0,0,0,.12)

  .site-brand-container
    border-radius: 3px 3px 0 0
    border-bottom: 1px solid rgba(255,215,0,.45)

  .sidebar-tag-cluster
    border-top-color: rgba(255,215,0,.45)

  .sidebar-tag-heading h3
    color: var(--world-ink)

  .sidebar-tag-heading > a
    color: var(--world-muted)
