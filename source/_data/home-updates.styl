// A compact reading list on the second sheet of the homepage correspondence.
.world-home
  .home-updates-list
    list-style: none
    margin: 0
    padding: 0

  .home-update
    --update-accent: var(--tone-amber)
    margin: 0
    padding: 0

    for tone in 'violet' 'blue' 'green' 'cyan' 'amber' 'rose'
      &[data-reading-tone={tone}]
        --update-accent: var(unquote('--tone-' + tone))

    + .home-update
      border-top: 1px solid var(--world-edge)

  .home-update-link
    display: grid
    grid-template-columns: 30px minmax(0, 1fr)
    gap: 18px
    margin: 0 -10px
    padding: 24px 10px
    border: 0
    border-radius: 3px
    color: var(--world-ink)
    font-weight: 400
    text-decoration: none
    transition: background-color .18s var(--interaction-ease)

    &:hover, &:focus-visible
      color: var(--world-ink)
      background: var(--world-gold-wash)

      .home-update-title
        text-decoration: underline
        text-decoration-color: var(--world-gold)
        text-underline-offset: 5px

      .home-update-read > span
        transform: translate(2px, -2px)

    &:focus-visible
      outline-offset: 2px

  .home-update-number
    padding-top: 2px
    color: var(--update-accent)
    font: 20px/1.4 Georgia, serif

  .home-update-copy
    min-width: 0

  .home-update-meta, .home-update-taxonomy
    display: flex
    flex-wrap: wrap
    justify-content: flex-start
    align-items: center
    gap: 6px 12px
    color: var(--world-muted)
    font-size: 12px
    line-height: 1.8

  .home-update-kind
    padding: 0 7px
    border: 1px solid unquote('color-mix(in srgb, var(--update-accent) 40%, var(--world-edge))')
    border-radius: 2px
    color: var(--update-accent)
    background: unquote('color-mix(in srgb, var(--update-accent) 8%, var(--world-paper))')

  .home-update-date
    display: inline-flex
    align-items: center
    gap: 8px
    margin-left: auto
    text-align: right
    white-space: nowrap

    time
      padding-left: 8px
      border-left: 1px solid var(--world-edge)
      color: var(--world-muted)
      font: 12px/1.6 var(--world-code-font)
      font-variant-numeric: tabular-nums

  .home-update-date-label
    padding: 1px 5px
    border-radius: 2px
    color: var(--tone-amber)
    background: var(--world-soft)
    font-size: 10px
    line-height: 1.7

  .home-update-title
    margin: 10px 0 8px
    padding: 0
    border: 0
    color: var(--world-ink)
    font: 600 18px/1.7 'Noto Serif SC', 'Songti SC', SimSun, serif
    overflow-wrap: anywhere

  .home-update-taxonomy
    margin-bottom: 10px
    overflow-wrap: anywhere

  .home-update-category
    color: var(--update-accent)

  .home-update-tag
    color: var(--tone-amber)
    font-size: 11px

  .home-update-summary
    display: -webkit-box
    -webkit-box-orient: vertical
    -webkit-line-clamp: 2
    overflow: hidden
    margin: 0
    color: var(--world-muted)
    font-size: 14px
    line-height: 1.9
    text-indent: 0
    overflow-wrap: anywhere

  .home-update-read
    display: inline-flex
    align-items: center
    gap: 8px
    margin-top: 12px
    color: var(--world-ink)
    font-size: 12px

    > span
      display: inline-block
      color: var(--update-accent)
      transition: transform .18s var(--interaction-ease)

  .home-updates-empty
    color: var(--world-muted)

@media (max-width: 767px)
  .world-home
    .home-update-link
      grid-template-columns: 24px minmax(0, 1fr)
      gap: 10px
      padding: 22px 8px
      margin: 0 -8px

    .home-update-number
      font-size: 17px

    .home-update-title
      font-size: 16px

    .home-update-meta, .home-update-taxonomy
      font-size: 11px

    .home-update-summary
      font-size: 13px
