{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}
{% import '_macro/content-directory.njk' as directory with context %}
{% block title %}{{ page.category }} | {{ title }}{% endblock %}
{% block class %}category directory-page{% endblock %}
{% block content %}
  {% set tree = content_directory('category') %}
  <div class="post-block"><div class="content-directory" data-tone="{{ tree.current.tone }}">
    <header class="directory-header"><nav class="directory-breadcrumb" aria-label="分类路径"><a href="{{ url_for('archives/') }}">总览</a><span aria-hidden="true">/</span><a href="{{ url_for('categories/') }}">分类</a>{% for ancestor in tree.breadcrumb %}<span aria-hidden="true">/</span>{% if loop.last %}<span aria-current="page">{{ ancestor.name | escape }}</span>{% else %}<a href="{{ url_for(ancestor.path) }}">{{ ancestor.name | escape }}</a>{% endif %}{% endfor %}</nav>
    <span class="directory-eyebrow">第九边缘 · 分类档案</span><h1>{{ page.category | escape }}</h1><p>沿着分类层级，浏览这个主题下的内容。</p><div class="directory-stats"><span><b>{{ tree.current.count }}</b> 篇文章</span>{% if tree.current.children.length %}<span><b>{{ tree.current.children.length }}</b> 个子分类</span>{% endif %}</div></header>
    {% if tree.current.children.length %}<nav class="directory-jump" aria-label="子分类导航">{% for child in tree.current.children %}{% if child.count %}<a href="{{ url_for(child.path) }}">{{ child.name | escape }}<span>{{ child.count }}</span></a>{% endif %}{% endfor %}</nav>{% endif %}
    {% if tree.current.entries.length %}{{ directory.entries(tree.current.entries) }}{% endif %}
    <div class="directory-category-grid">{% for child in tree.current.children %}{{ directory.category(child) }}{% endfor %}</div>
  </div></div>
  {% include '_partials/pagination.njk' %}
{% endblock %}
{% block sidebar %}{{ sidebar_template.render(false) }}{% endblock %}
