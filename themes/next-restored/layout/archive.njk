{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}
{% import '_macro/content-directory.njk' as directory with context %}
{% block title %}总览 | {{ title }}{% endblock %}
{% block class %}archive directory-page{% endblock %}
{% block content %}
  {% set tree = content_directory('overview') %}
  <div class="post-block"><div class="content-directory">
    <header class="directory-header">
      <span class="directory-eyebrow">第九边缘 · 文明档案</span><h1>世界总览</h1><p>从文明到主题，再走进每一篇记录。</p>
      {{ partial('_partials/world-meta.njk', {document: page}) }}
      <div class="directory-stats"><span><b>{{ site.posts.length }}</b> 篇文章</span><span><b>{{ tree.roots.length }}</b> 个文明分区</span><a href="{{ url_for('categories/') }}">分类导航 <span aria-hidden="true">↗</span></a></div>
    </header>
    <nav class="directory-jump" aria-label="文明分区导航">{% for node in tree.roots %}{% if node.count %}<a data-tone="{{ node.tone }}" href="#{{ node.anchor }}">{{ node.name | escape }}<span>{{ node.count }}</span></a>{% endif %}{% endfor %}</nav>
    <div class="directory-tree">{% for node in tree.roots %}{{ directory.category(node) }}{% endfor %}</div>
    <section class="directory-addendum"><div class="directory-section-heading"><h2>外世延伸</h2><span class="directory-count">四个内容入口</span></div>{{ directory.collections(world_collections()) }}</section>
  </div></div>
  {% include '_partials/pagination.njk' %}
{% endblock %}
{% block sidebar %}{{ sidebar_template.render(false) }}{% endblock %}
