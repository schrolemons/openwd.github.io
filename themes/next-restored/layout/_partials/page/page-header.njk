<header class="post-header">
{% if reading %}<div class="reading-kicker"><span>{{ reading.label }}</span><span>{{ reading.description }}</span></div>{% endif %}

<h1 class="post-title" itemprop="name headline">
  {{- page.title }}
  {{- post_edit(page.source) }}
</h1>

<div class="post-meta-container">
  {{ partial('_partials/world-meta.njk', {document: page}) }}
  {%- if page.description %}
    <div class="post-description">{{ page.description }}</div>
  {%- endif %}
  {%- include '_partials/page/breadcrumb.njk' -%}
</div>

</header>
