<div style="position: fixed; top: 24px; left: 24px; z-index: 100;">
    <a href="<%- url_for('/') %>" class="back-btn">
        <svg class="svg-icon" style="vertical-align: middle; margin-right: 4px; width: 16px; height: 16px;"
            viewBox="0 0 24 24">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        放回桌面
    </a>
</div>

<article class="post-container module"
    style="position: relative; margin: 80px auto 40px auto; transform: none; max-width: 800px; width: 90%; cursor: auto;">
    <h1 style="font-size: 28px; margin-bottom: 8px;"><%- page.title %></h1>

    <!-- 排除标签、分类和友链页面的日期显示 -->
    <% if (page.type !=='tags' && page.type !=='categories' && page.type !=='friends' ) { %>
        <div class="post-meta" style="margin-bottom: 32px;">
            发布于 <%= date(page.date, 'YYYY.MM.DD' ) %>
        </div>
        <% } else { %>
            <div style="margin-bottom: 32px;"></div>
            <% } %>

                <div class="post-content">
                    <% if (page.type==='tags' ) { %>
                        <div class="tag-cloud">
                            <%- tagcloud({ min_font: 13, max_font: 24, amount: 100, color: true, start_color: '#737373'
                                , end_color: '#1A1A1A' }) %>
                        </div>
                        <% } else if (page.type==='categories' ) { %>
                            <div class="category-tree">
                                <%- list_categories({ show_count: true }) %>
                            </div>
                            <% } else if (page.type==='friends' ) { %>
                                <!-- 🌟 友链专属渲染逻辑 -->
                                <%- page.content %> <!-- 允许你在 md 文件中写一段开场白 -->

                                    <% if (page.links && page.links.length> 0) { %>
                                        <div class="friends-grid">
                                            <% page.links.forEach(function(link){ %>
                                                <a href="<%- link.url %>" target="_blank" class="friend-card">
                                                    <!-- 如果没有配置头像，则使用一个极简的默认几何头像 -->
                                                    <img class="friend-avatar"
                                                        src="<%- link.avatar || 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%231A1A1A%22/><circle cx=%2250%22 cy=%2250%22 r=%2220%22 fill=%22%23FFF%22/></svg>' %>"
                                                        alt="<%- link.name %>">
                                                    <div class="friend-info">
                                                        <span class="friend-name"><%- link.name %></span>
                                                        <span class="friend-desc"><%- link.desc || link.url %></span>
                                                    </div>
                                                </a>
                                                <% }) %>
                                        </div>
                                        <% } %>
                                            <% } else { %>
                                                <%- page.content %>
                                                    <% } %>
                </div>
</article>