<div style="position: fixed; top: 24px; left: 24px; z-index: 100;">
    <a href="<%- url_for('/') %>" class="back-btn">
        <svg class="svg-icon" style="vertical-align: middle; margin-right: 4px; width: 16px; height: 16px;"
            viewBox="0 0 24 24">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        放回桌面
    </a>
</div>

<!-- 卡片 -->
<article class="post-container module"
    style="position: relative; margin: 80px auto 40px auto; transform: none; max-width: 800px; width: 90%; cursor: auto;">
    <h1 style="font-size: 28px; margin-bottom: 8px;"><%- page.title %></h1>
    <div class="post-meta" style="margin-bottom: 32px;">
        发布于 <%= date(page.date, 'YYYY.MM.DD' ) %>
            <% if (page.tags && page.tags.length){ %>
                ·
                <% page.tags.each(function(tag){ %>
                    <span style="color: var(--accent);">#<%= tag.name %></span>
                    <% }) %>
                        <% } %>
    </div>

    <!-- 正文 -->
    <div class="post-content">
        <%- page.content %>
    </div>

    <div class="copyright-box">
        <strong>Copyright Notice:</strong> All articles in this blog are licensed under <a
            href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank">BY-NC-SA</a> unless stating
        additionally.
    </div>

    <div class="post-navigation">
        <% if (page.prev){ %>
            <a href="<%- url_for(page.prev.path) %>" class="nav-prev">
                <span class="nav-label">← 上一篇</span>
                <span class="nav-title">
                    <%= page.prev.title %>
                </span>
            </a>
            <% } else { %>
                <div class="nav-prev empty"></div>
                <% } %>

                    <% if (page.next){ %>
                        <a href="<%- url_for(page.next.path) %>" class="nav-next">
                            <span class="nav-label">下一篇 →</span>
                            <span class="nav-title">
                                <%= page.next.title %>
                            </span>
                        </a>
                        <% } else { %>
                            <div class="nav-next empty"></div>
                            <% } %>
    </div>
</article>