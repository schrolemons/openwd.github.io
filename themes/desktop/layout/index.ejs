<div class="controls">
    <button id="scatter-btn">
        <svg class="svg-icon" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 6px;"
            viewBox="0 0 24 24">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.92-10.44l5.67-5.67" />
        </svg>
        整理桌面
    </button>
</div>

<!-- 导航 -->
<div class="module mod-nav">
    <h3 style="display: flex; align-items: center; gap: 8px;">
        <svg class="svg-icon" style="width: 20px; height: 20px;" viewBox="0 0 24 24">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
        Map
    </h3>
    <div style="display: flex; flex-direction: column; gap: 14px;">
        <a href="<%- url_for('/archives') %>" class="nav-link">Archives<span>→</span></a>
        <a href="<%- url_for('/categories') %>" class="nav-link">Categories<span>→</span></a>
        <a href="<%- url_for('/tags') %>" class="nav-link">Tags<span>→</span></a>
        <a href="<%- url_for('/friends') %>" class="nav-link">Friends<span>→</span></a>
        <a href="<%- url_for('/about') %>" class="nav-link">About<span>→</span></a>
    </div>
</div>

<!-- 文章列表 -->
<div class="module mod-posts">
    <h3 style="display: flex; align-items: center; justify-content: space-between;">
        Notes
        <svg class="svg-icon" viewBox="0 0 24 24">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
    </h3>
    <% site.posts.sort('date', -1).limit(5).each(function(post){ %>
        <div class="post-item">
            <span class="post-meta">
                <%= date(post.date, 'YYYY.MM.DD' ) %>
            </span>
            <a href="<%- url_for(post.path) %>">
                <%= post.title || '无标题' %>
            </a>
        </div>
        <% }) %>
            <div style="text-align: right; margin-top: 8px;">
                <a href="<%- url_for('/archives') %>"
                    style="font-size: 13px; color: var(--text-muted); border-bottom: none;">查看全部 <%= site.posts.length
                        %> 篇 →</a>
            </div>
</div>

<!-- tag -->
<div class="module mod-tags">
    <h3>Tags</h3>
    <div class="tag-list">
        <% site.tags.sort('length', -1).limit(8).each(function(tag){ %>
            <a href="<%- url_for(tag.path) %>" class="tag"># <%= tag.name %></a>
            <% }) %>
                <a href="<%- url_for('/tags') %>" class="tag"
                    style="background: var(--primary-bg); color: var(--primary-text); border: none;">所有标签</a>
    </div>
</div>

<!-- 联系方式 -->
<% if (theme.social) { %>
    <div class="module mod-contact">
        <h3>Contact me</h3>
        <div style="display: flex; gap: 16px; margin-top: 8px;">
            <% if (theme.social.GitHub) { %>
                <a href="<%- theme.social.GitHub %>" title="GitHub" target="_blank"
                    style="border: none; color: var(--text-main);">
                    <svg class="svg-icon" viewBox="0 0 24 24">
                        <path
                            d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22">
                        </path>
                    </svg>
                </a>
                <% } %>
                    <% if (theme.social.Twitter) { %>
                        <a href="<%- theme.social.Twitter %>" title="Twitter" target="_blank"
                            style="border: none; color: var(--text-main);">
                            <svg class="svg-icon" viewBox="0 0 24 24">
                                <path
                                    d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z">
                                </path>
                            </svg>
                        </a>
                        <% } %>
                            <% if (theme.social.Mail) { %>
                                <a href="<%- theme.social.Mail %>" title="Mail"
                                    style="border: none; color: var(--text-main);">
                                    <svg class="svg-icon" viewBox="0 0 24 24">
                                        <path
                                            d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z">
                                        </path>
                                        <polyline points="22,6 12,13 2,6"></polyline>
                                    </svg>
                                </a>
                                <% } %>
        </div>
    </div>
    <% } %>

        <% if (theme.quote) { %>
            <div class="module mod-quote" style="background: var(--quote-bg); color: var(--quote-text);">
                <svg class="svg-icon" style="stroke: var(--accent); margin-bottom: -8px;" viewBox="0 0 24 24">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                <p style="color: var(--quote-muted); font-style: italic; font-family: serif; font-size: 16px;">
                    "<%- theme.quote.text %>"
                </p>
                <span class="post-meta" style="color: var(--quote-muted);">— <%- theme.quote.author %></span>
            </div>
            <% } %>


                <!-- about -->
                <div class="module mod-profile">
                    <svg viewBox="0 0 100 100" style="width: 48px; height: 48px; margin-bottom: 8px;">
                        <rect x="0" y="0" width="100" height="100" fill="var(--text-main)" rx="4"></rect>
                        <circle cx="50" cy="50" r="20" fill="var(--card-bg)"></circle>
                        <path d="M50 50 L80 80" stroke="var(--bg-color)" stroke-width="8"></path>
                    </svg>
                    <h2>Hi, 我是 <%- config.author %>。</h2>
                    <p><%- config.description || '这里没有固定的格子, 像浏览桌上的卡片一样, 你可以随意拖动它们.' %></p>
                    <div>
                        <a href="<%- url_for('/about') %>">Read more →</a>
                    </div>
                </div>