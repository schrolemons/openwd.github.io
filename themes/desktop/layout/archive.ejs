<!-- themes/desktop/layout/archive.ejs -->
<div style="position: fixed; top: 24px; left: 24px; z-index: 100;">
    <a href="<%- url_for('/') %>" class="back-btn">
        <svg class="svg-icon" style="vertical-align: middle; margin-right: 4px; width: 16px; height: 16px;"
            viewBox="0 0 24 24">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        放回桌面
    </a>
</div>

<article class="post-container module"
    style="position: relative; margin: 80px auto; transform: none; max-width: 800px; width: 90%; cursor: auto;">
    <h1 style="font-size: 28px; margin-bottom: 32px;">
        所有笔记 <span style="color: var(--text-muted); font-size: 16px; font-weight: normal;">(共 <%= site.posts.length %>
                篇)</span>
    </h1>

    <div class="archive-list">
        <% page.posts.each(function(post) { %>
            <div class="archive-item">
                <span class="post-meta" style="margin-right: 16px; min-width: 80px; display: inline-block;">
                    <%= date(post.date, 'YYYY.MM.DD' ) %>
                </span>
                <a href="<%- url_for(post.path) %>">
                    <%= post.title || '无标题' %>
                </a>
            </div>
            <% }) %>
    </div>

    <% if (page.total> 1) { %>
        <div class="pagination" style="margin-top: 32px; border-top: 1px solid var(--border-color); padding-top: 16px;">
            <%- paginator({ prev_text: '← 上一页' , next_text: '下一页 →' }) %>
        </div>
        <% } %>
</article>